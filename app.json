{
  "expo": {
    "name": "Ansdimat",
    "slug": "ansdimat",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-app.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omnion.Ansdimat",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to show your position on the map and add field diary points.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to show your position on the map and add field diary points.",
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.omnion.ansdimat.project",
            "UTTypeDescription": "ANSDIMAT Project",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["ansdimat"],
              "public.mime-type": ["application/vnd.ansdimat.project+json"]
            }
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "ANSDIMAT Project",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.omnion.ansdimat.project"]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive.png",
        "backgroundColor": "#72002F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.omnion.Ansdimat",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.ansdimat" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\.ansdimat" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\..*\\\\.ansdimat" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\.ansdimat" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.ansdimat" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\.ansdimat" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\..*\\\\.ansdimat" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\..*\\\\..*\\\\..*\\\\.ansdimat" }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#72002F",
          "dark": {
            "backgroundColor": "#72002F"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to save charts and attach them to field diary points.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save charts to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to save charts and attach them to field diary points.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos of observation points."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to record voice notes for field diary points."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show your position on the map and add field diary points.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location in the background for field diary tracking.",
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show your position on the map and add field diary points."
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "4e1153c8-243d-40a1-9893-99873fc8bd63"
      }
    },
    "owner": "entropus",
    "scheme": "ansdimat"
  }
}
