# Ключи Supabase для аккаунтов и синхронизации.
# Скопируйте в .env и подставьте значения из Project Settings -> API.
# Инструкция: docs/supabase/README.md
#
# Префикс EXPO_PUBLIC_ обязателен: иначе переменная не попадёт в приложение.
# Здесь может быть только anon public key: service_role обходит политики RLS.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
