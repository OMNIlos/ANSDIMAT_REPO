{
  "cli": {
    "version": ">= 16.13.3",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },

    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },

    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },

    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    }
  },

  "submit": {
    "production": {}
  }
}
